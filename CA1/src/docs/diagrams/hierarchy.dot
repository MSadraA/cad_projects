digraph FCNN {
graph [fontname="DejaVu Sans", rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.55", splines=polyline];
node [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor="#edf3fa", color="#526780", margin="0.15,0.12"];
edge [fontname="DejaVu Sans", fontsize=9, color="#526780", arrowsize=0.7];
label="RTL hierarchy - 17 module types / 19 instances"; labelloc=t; fontsize=19;
top [label="fcnn_top / dut"];
controller [label="controller_inst / fcnn_controller"];
datapath [label="datapath_inst / fcnn_datapath"];
children [shape=plain, style="", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="8"><TR><TD BGCOLOR="#edf3fa" CELLPADDING="12"><B>address_inst</B><BR/><FONT POINT-SIZE="10">fcnn_address_generator</FONT></TD><TD BGCOLOR="#edf3fa" CELLPADDING="12"><B>weight_sram_inst</B><BR/><FONT POINT-SIZE="10">fcnn_row_sram</FONT></TD><TD BGCOLOR="#edf3fa" CELLPADDING="12"><B>input_sram_inst</B><BR/><FONT POINT-SIZE="10">fcnn_row_sram</FONT></TD><TD BGCOLOR="#edf3fa" CELLPADDING="12"><B>weight_stage_inst</B><BR/><FONT POINT-SIZE="10">fcnn_row_stage</FONT></TD></TR><TR><TD BGCOLOR="#edf3fa" CELLPADDING="12"><B>input_stage_inst</B><BR/><FONT POINT-SIZE="10">fcnn_row_stage</FONT></TD><TD BGCOLOR="#edf3fa" CELLPADDING="12"><B>scheduler_inst</B><BR/><FONT POINT-SIZE="10">fcnn_local_scheduler</FONT></TD><TD BGCOLOR="#edf3fa" CELLPADDING="12"><B>router_inst</B><BR/><FONT POINT-SIZE="10">fcnn_operand_router</FONT></TD><TD BGCOLOR="#edf3fa" CELLPADDING="12"><B>multiplier_inst</B><BR/><FONT POINT-SIZE="10">fcnn_fp16_multiplier</FONT></TD></TR><TR><TD BGCOLOR="#edf3fa" CELLPADDING="12"><B>product_inst</B><BR/><FONT POINT-SIZE="10">fcnn_product_register</FONT></TD><TD BGCOLOR="#edf3fa" CELLPADDING="12"><B>ping_pong_inst</B><BR/><FONT POINT-SIZE="10">fcnn_ping_pong_buffer</FONT></TD><TD BGCOLOR="#edf3fa" CELLPADDING="12"><B>adder_inst</B><BR/><FONT POINT-SIZE="10">fcnn_fp16_adder</FONT></TD><TD BGCOLOR="#edf3fa" CELLPADDING="12"><B>bias_inst</B><BR/><FONT POINT-SIZE="10">fcnn_bias_rom</FONT></TD></TR><TR><TD BGCOLOR="#edf3fa" CELLPADDING="12"><B>accumulator_inst</B><BR/><FONT POINT-SIZE="10">fcnn_accumulator_bank</FONT></TD><TD BGCOLOR="#edf3fa" CELLPADDING="12"><B>relu_inst</B><BR/><FONT POINT-SIZE="10">fcnn_relu_fp16</FONT></TD><TD BGCOLOR="#edf3fa" CELLPADDING="12"><B>regfile_inst</B><BR/><FONT POINT-SIZE="10">fcnn_activation_regfile</FONT></TD><TD BGCOLOR="#edf3fa" CELLPADDING="12"><B>argmax_inst</B><BR/><FONT POINT-SIZE="10">fcnn_argmax</FONT></TD></TR></TABLE>>];
top -> controller;top -> datapath;
datapath -> children [label="every cell is a direct child instance"];
}
